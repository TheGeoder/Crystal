set(ANDROID_ABI "arm64-v8a" CACHE STRING "Target 64-bit ARM architecture")
set(ANDROID_PLATFORM "android-24" CACHE STRING "Minimum Android API level (Android 7.0)")
set(ANDROID_STL "c++_shared" CACHE STRING "Use shared C++ runtime to match GD")
if(DEFINED ENV{ANDROID_NDK_HOME})
    include("$ENV{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake")
elseif(DEFINED ENV{ANDROID_NDK})
    include("$ENV{ANDROID_NDK}/build/cmake/android.toolchain.cmake")
else()
    message(FATAL_ERROR "Android NDK not found! Please set ANDROID_NDK_HOME.")
endif()
